# PostgreSQL connection used by the application
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME

# PostgreSQL connection used by the automated test suite
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/averisq_test_db

# JWT configuration
# Replace JWT_SECRET_KEY with a strong, unique secret before running the app.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
